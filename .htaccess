Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect any lowercase /chat request to /Messages
    RewriteRule ^chat/?$        /Messages      [R=302,L,NC]
    RewriteRule ^chat/(.*)$     /Messages/$1   [R=302,L,NC]

    # Don't rewrite real files/folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → index.php
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "\.(sql|md|log|env|lock|ini|sh|bak)$">
    Require all denied
</FilesMatch>