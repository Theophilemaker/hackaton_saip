# =====================================================================
# SAIP Database Folder Protection
# Blocks ALL web access to SQL files and migrations
# =====================================================================

# Deny all access (Apache 2.4+)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Deny all access (Apache 2.2 fallback)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Block SQL files explicitly
<FilesMatch "\.(sql|sqlite|db|dump|bak|gz|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>